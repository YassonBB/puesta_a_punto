extends layout

block content
  h1= title
  a(href="/login" style="float:right; color:red;") Cerrar sesión
  
  div(style="display: flex; gap: 20px; margin-top: 20px;")
    // LISTA DE COMPAÑEROS
    div(style="width: 30%; border-right: 1px solid #ccc; padding-right: 10px;")
      h3 Compañeros de Grupo
      ul
        each u in usuarios
          if u.id !== mi_id
            li= u.nombre + ' (' + u.rol + ')'
    
    // BANDEJA DE CHAT
    div(style="width: 70%;")
      div(style="border: 1px solid #ccc; height: 300px; overflow-y: auto; padding: 10px; margin-bottom: 10px; background: #f9f9f9;")
        if mensajes && mensajes.length > 0
          each msg in mensajes
            div(style=msg.emisor_id === mi_id ? "text-align: right; margin-bottom: 10px;" : "text-align: left; margin-bottom: 10px;")
              strong(style=msg.emisor_id === mi_id ? "color: blue;" : "color: green;")= (msg.emisor_id === mi_id ? 'Yo' : msg.emisor_nombre) + ': '
              span= msg.contenido
        else
          p No hay mensajes en el grupo.

      // FORMULARIO DE ENVÍO
      form(action="/mensajes" method="POST")
        select(name="receptor_id" required style="margin-right:10px; padding: 5px;")
          option(value="") Selecciona destinatario...
          each u in usuarios
            if u.id !== mi_id
              option(value=u.id)= u.nombre
        input(type="text" name="contenido" placeholder="Escribe tu mensaje..." required style="width: 40%; margin-right:10px; padding: 5px;")
        button(type="submit" style="padding: 5px 15px;") Enviar