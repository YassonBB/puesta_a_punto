extends layout

block content
  h1= title
  a(href="/login" style="float:right; color:red;") Cerrar sesión
  
  div(style="display: flex; gap: 30px; margin-top: 20px;")
    // GESTIÓN DE GRUPOS
    div(style="width: 30%; border-right: 1px solid #ccc; padding-right: 15px;")
      h3 1. Alta de Grupos
      form(action="/users/grupos" method="POST")
        input(type="text" name="nombre" placeholder="Nombre del grupo" required style="width: 100%; margin-bottom: 10px; padding: 5px;")
        button(type="submit" style="width: 100%;") Guardar Grupo
      
      h4 Grupos Existentes
      ul
        each g in grupos
          li= g.nombre

    // GESTIÓN DE USUARIOS
    div(style="width: 70%;")
      h3 2. Alta de Usuarios
      form(action="/users/crear" method="POST" enctype="multipart/form-data" style="background: #f1f1f1; padding: 15px; border-radius: 5px;")
        div(style="display:flex; gap:10px; margin-bottom: 10px;")
          input(type="text" name="nombre" placeholder="Usuario" required)
          input(type="password" name="password" placeholder="Contraseña" required)
        div(style="display:flex; gap:10px; margin-bottom: 10px;")
          select(name="rol" required)
            option(value="usuario") Usuario Normal
            option(value="admin") Administrador
          select(name="grupo_id" required)
            option(value="") Seleccionar Grupo...
            each g in grupos
              option(value=g.id)= g.nombre
        div(style="margin-bottom: 10px;")
          label Foto de perfil: 
          input(type="file" name="foto" accept="image/*")
        button(type="submit") Registrar Usuario

      h3 Usuarios Registrados
      table(border="1" cellpadding="8" style="width: 100%; border-collapse: collapse; margin-top:10px;")
        thead(style="background: #ddd;")
          tr
            th Foto
            th Nombre
            th Rol
            th Grupo
            th Acciones
        tbody
          each u in usuarios
            tr
              td(style="text-align: center;")
                if u.foto_perfil
                  img(src=u.foto_perfil width="40" height="40" style="border-radius:50%;")
                else
                  span(style="color:#777; font-size: 12px;") Sin foto
              td= u.nombre
              td= u.rol
              td= u.grupo_nombre
              td
                if u.rol !== 'admin'
                  form(action="/users/eliminar/" + u.id method="POST" style="margin:0;")
                    button(type="submit" style="color:white; background:red; border:none; padding:5px 10px; cursor:pointer;") Baja
                else
                  span(style="color: var(--texto-secundario); font-size: 0.85rem; font-weight: bold;") PROTEGIDO