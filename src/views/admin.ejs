<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Panel de Administración</title>
</head>
<body>
  <h1>Panel de Control del Administrador</h1>

  <!-- SECCIÓN DE GRUPOS -->
  <h2>Gestión de Grupos</h2>
  <form action="/admin/groups" method="POST">
    <input type="text" name="name" placeholder="Nombre del Grupo" required>
    <input type="text" name="description" placeholder="Descripción">
    <button type="submit">Crear Grupo</button>
  </form>

  <h3>Grupos Existentes</h3>
  <ul>
    <% groups.forEach(group => { %>
      <li>
        <strong><%= group.name %></strong> - <%= group.description %>
        <form action="/admin/groups/delete/<%= group.id %>" method="POST" style="display:inline;">
          <button type="submit">Eliminar</button>
        </form>
      </li>
    <% }) %>
  </ul>

  <hr>

  <!-- SECCIÓN DE USUARIOS -->
  <h2>Gestión de Usuarios</h2>
  <form action="/admin/users" method="POST" enctype="multipart/form-data">
    <input type="text" name="name" placeholder="Nombre completo" required><br>
    <input type="email" name="email" placeholder="Email" required><br>
    <input type="password" name="password" placeholder="Contraseña" required><br>
    
    <label>Rol:</label>
    <select name="role">
      <option value="user">Usuario normal</option>
      <option value="admin">Administrador</option>
    </select><br>

    <label>Asignar Grupo Único:</label>
    <select name="groupId" required>
      <option value="">-- Selecciona un grupo --</option>
      <% groups.forEach(group => { %>
        <option value="<%= group.id %>"><%= group.name %></option>
      <% }) %>
    </select><br>

    <label>Foto de Perfil:</label>
    <input type="file" name="photo" accept="image/*" required><br><br>

    <button type="submit">Crear Usuario</button>
  </form>

  <h3>Usuarios Registrados</h3>
  <table border="1">
    <thead>
      <tr>
        <th>Foto</th>
        <th>Nombre</th>
        <th>Email</th>
        <th>Rol</th>
        <th>Grupo</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(user => { %>
        <tr>
          <td><img src="<%= user.photo %>" width="40" height="40" style="object-fit:cover;"></td>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><%= user.role %></td>
          <td><%= user.Group ? user.Group.name : 'Sin grupo' %></td>
          <td>
            <form action="/admin/users/delete/<%= user.id %>" method="POST">
              <button type="submit">Dar de Baja</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>